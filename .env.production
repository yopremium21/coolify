APP_ID=
APP_NAME=Coolify
APP_KEY=

DB_USERNAME=coolify
DB_PASSWORD=

REDIS_PASSWORD=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=

ROOT_USERNAME=
ROOT_USER_EMAIL=
ROOT_USER_PASSWORD=

REGISTRY_URL=docker.io

# Fork-native Coolify sources/images
COOLIFY_IMAGE=ghcr.io/yopremium21/coolify:low-memory
HELPER_IMAGE=ghcr.io/yopremium21/coolify-helper
REALTIME_IMAGE=ghcr.io/yopremium21/coolify-realtime:1.0.18
CDN_URL=https://raw.githubusercontent.com/yopremium21/coolify/main
VERSIONS_URL=https://raw.githubusercontent.com/yopremium21/coolify/main/versions.json
UPGRADE_SCRIPT_URL=https://raw.githubusercontent.com/yopremium21/coolify/main/scripts/upgrade-fork.sh
RELEASES_URL=https://raw.githubusercontent.com/yopremium21/coolify/main/versions.json
SERVICE_TEMPLATES_URL=https://raw.githubusercontent.com/yopremium21/coolify/main/templates/service-templates-latest.json
AUTOUPDATE=false

# 1 GB VPS defaults
PHP_MEMORY_LIMIT=192M
PHP_FPM_PM_CONTROL=ondemand
PHP_FPM_PM_MAX_CHILDREN=2
PHP_FPM_PM_PROCESS_IDLE_TIMEOUT=10s
HORIZON_BALANCE=false
HORIZON_MIN_PROCESSES=1
HORIZON_MAX_PROCESSES=1
HORIZON_MEMORY_LIMIT=48
HORIZON_WORKER_MEMORY=96
HORIZON_MAX_JOBS=100
POSTGRES_SHARED_BUFFERS=32MB
POSTGRES_EFFECTIVE_CACHE_SIZE=128MB
POSTGRES_WORK_MEM=1MB
POSTGRES_MAINTENANCE_WORK_MEM=16MB
POSTGRES_MAX_CONNECTIONS=30
